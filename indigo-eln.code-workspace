{
  "folders": [
    {
      "name": "Indigo ELN v2.0",
      "path": "."
    }
  ],
  "settings": {
    "peacock.color": "#00CC66",
    "peacock.remoteColor": "#00CC66",
    "workbench.editor.restoreViewState": true,
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#00ff80",
      "activityBar.activeBorder": "#90ee90",
      "activityBar.background": "#00ff80",
      "activityBar.foreground": "#15202b",
      "activityBar.inactiveForeground": "#15202b99",
      "activityBarBadge.background": "#bf80ff",
      "activityBarBadge.foreground": "#15202b",
      "commandCenter.border": "#15202b99",
      "sash.hoverBorder": "#00ff80",
      "statusBar.background": "#00cc66",
      "statusBar.foreground": "#15202b",
      "statusBarItem.hoverBackground": "#00994d",
      "statusBarItem.remoteBackground": "#00cc66",
      "statusBarItem.remoteForeground": "#15202b",
      "titleBar.activeBackground": "#00cc66",
      "titleBar.activeForeground": "#15202b",
      "titleBar.inactiveBackground": "#00cc6699",
      "titleBar.inactiveForeground": "#15202b99"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/target": true,
      "**/.git": true,
      "**/.DS_Store": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.ts": "${capture}.js",
      "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
      "*.jsx": "${capture}.js",
      "*.tsx": "${capture}.ts",
      "tsconfig.json": "tsconfig.*.json",
      "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml",
      "pom.xml": "mvnw, mvnw.cmd"
    }
  },
  "extensions": {
    "recommendations": [
      "johnpapa.vscode-peacock",
      "ms-vscode.vscode-typescript-next",
      "angular.ng-template",
      "ms-vscode.vscode-json",
      "bradlc.vscode-tailwindcss"
    ]
  }
}