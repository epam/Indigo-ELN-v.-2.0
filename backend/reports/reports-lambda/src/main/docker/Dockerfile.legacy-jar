FROM registry.access.redhat.com/ubi9/openjdk-21

ENV LANGUAGE='en_US:en'

COPY --chown=185 build/lib/* /app/lib/
COPY --chown=185 build/*-runner.jar /app/quarkus-run.jar

EXPOSE 8080
EXPOSE 5005
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager --add-opens java.base/jdk.internal.misc=ALL-UNNAMED -Djava.net.preferIPv6Addresses=false"
ENV JAVA_APP_JAR="/app/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
