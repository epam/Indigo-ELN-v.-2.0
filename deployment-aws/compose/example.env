# Shape of the .env that /opt/indigoeln/deploy.sh writes on the instance. Values here are
# placeholders — the real ones come from the SSM parameter (non-secret) plus the Secrets Manager
# secret (DB_PASSWORD). Kept in the repo so `docker compose config` can be run locally:
#
#   cd deployment-aws/compose && docker compose --env-file ./example.env config

AWS_REGION=us-east-1
AWS_LOG_GROUP=/indigoeln/dev/compose

POSTGRES_IMAGE=657609648574.dkr.ecr.us-east-1.amazonaws.com/indigoeln/postgres.combined:latest
ELN_AWS_IMAGE=657609648574.dkr.ecr.us-east-1.amazonaws.com/indigoeln/indigo-eln-aws:latest
REPORTS_AWS_IMAGE=657609648574.dkr.ecr.us-east-1.amazonaws.com/indigoeln/indigo-eln-reports-aws:latest
SIGNATURE_AWS_IMAGE=657609648574.dkr.ecr.us-east-1.amazonaws.com/indigoeln/indigo-eln-signature-aws:latest
SAMPLEREGISTRATION_AWS_IMAGE=657609648574.dkr.ecr.us-east-1.amazonaws.com/indigoeln/indigo-eln-sampleregistration-aws:latest

ELN_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
ELN_STORAGE_S3_BUCKET=indigoeln-data-dev
ELN_API_SECRET=replace-me
ELN_SIGNATURE_KEYSTORE_PASSWORD=replace-me

DB_PASSWORD=replace-me
