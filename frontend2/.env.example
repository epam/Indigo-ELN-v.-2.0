# Cognito user pool backing the deployed app (see indigo-frontend/src/environments/environment.prod.ts).
# Copy to .env.local.
#
# us-east-1 only, for now: `vite.config.ts` names cognito-idp.us-east-1.amazonaws.com in the
# Content-Security-Policy's connect-src, and CloudFront serves that same policy string. A pool in
# another region would have its sign-in blocked by CSP — with no toast, since the request never
# reaches apiFetch — so moving regions means changing that entry too. Every CDK environment is
# us-east-1 today (deployment-aws/{dev,test,global}.json).
VITE_COGNITO_USER_POOL_ID=us-east-1_bgZNcyeDz
VITE_COGNITO_CLIENT_ID=3bqu2iod15b0otft0ap8umlfgh
